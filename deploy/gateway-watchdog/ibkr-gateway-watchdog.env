# IBKR API probe. This connection is read-only and uses its own client ID.
IBKR_WATCHDOG_HOST=127.0.0.1
IBKR_WATCHDOG_PORT=4002
IBKR_WATCHDOG_CLIENT_ID=997
IBKR_WATCHDOG_PROBE_INTERVAL_SECONDS=60
IBKR_WATCHDOG_PROBE_TIMEOUT_SECONDS=10

# Restart after five ordinary failures. During the maintenance window the
# watchdog records failures but never restarts Gateway.
IBKR_WATCHDOG_FAILURE_THRESHOLD=5
IBKR_WATCHDOG_MAINTENANCE_START=23:50
IBKR_WATCHDOG_MAINTENANCE_END=02:05
IBKR_WATCHDOG_WEEKEND_QUIET_END_SUNDAY=08:00
IBKR_WATCHDOG_TIME_ZONE=America/New_York

# Try one automatic restart per outage. If it does not recover, the watchdog
# waits for an operator instead of entering a restart loop. Even after a
# successful recovery, allow no more than one automatic restart per 24 hours.
IBKR_WATCHDOG_MINIMUM_AUTOMATIC_RESTART_INTERVAL_SECONDS=86400
IBKR_WATCHDOG_RESTART_COMMAND_TIMEOUT_SECONDS=60
IBKR_WATCHDOG_RECOVERY_TIMEOUT_SECONDS=180
IBKR_WATCHDOG_RECOVERY_PROBE_INTERVAL_SECONDS=10
IBKR_WATCHDOG_LOG_LEVEL=INFO
IBKR_WATCHDOG_IB_ASYNC_LOG_LEVEL=WARNING
